# Square API access token (from Square Developer Dashboard)
SQUARE_ACCESS_TOKEN=

# Square location ID(s), comma-separated if multiple (max 10)
SQUARE_LOCATION_ID=

# Optional: use sandbox (default: production)
# SQUARE_SANDBOX=1

# Optional: base URL for order links in report output (default: app.squareup.com or squareupsandbox.com dashboard)
# SQUARE_ORDER_URL_BASE=https://app.squareup.com/dashboard/orders/overview

# Seasonal report product mapping (comma-separated Square variation IDs)
SQUARE_CAST_PARTY_VARIATION_IDS=
SQUARE_SOUVENIR_PROGRAM_VARIATION_IDS=
SQUARE_VIP_BAG_VARIATION_IDS=
SQUARE_DVD_VARIATION_IDS=
# Optional: extra DVD bundle IDs (e.g., 2-pack with original show)
SQUARE_DVD_BUNDLE_VARIATION_IDS=
